# Local Postgres from compose.yaml (`docker compose up -d`).
DATABASE_URL=postgres://cartly:cartly@localhost:5433/cartly

# Admin login. Change both for any shared or deployed environment.
ADMIN_PASSWORD=change-me
# Signs the session cookie. Generate with:
# node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
SESSION_SECRET=replace-with-a-random-32-byte-string

# Stripe test mode: https://dashboard.stripe.com/test/apikeys (starts with sk_test_).
STRIPE_SECRET_KEY=sk_test_replace-me
# Public base URL of the site: Stripe redirects, sitemap, canonical and Open Graph URLs.
SITE_URL=http://localhost:3001
# Webhook signing secret. Locally it's printed by `stripe listen` (starts with whsec_).
STRIPE_WEBHOOK_SECRET=whsec_replace-me
